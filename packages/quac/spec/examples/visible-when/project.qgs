<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Visible when" version="3.44.8-Solothurn">
  <title>Visible when</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="trees_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>trees_1</id>
      <datasource>./trees_1.geojson</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="status"/>
        <field configurationFlags="NoFlag" name="removal_reason"/>
      </fieldConfiguration>
      <editorlayout>tablayout</editorlayout>
      <attributeEditorForm>
        <attributeEditorField index="0" name="status" showLabel="1"/>
        <attributeEditorContainer name="Removal" showLabel="1" groupBox="1" type="GroupBox" columnCount="1" visibilityExpression="&quot;status&quot; = 'Removed'" visibilityExpressionEnabled="1">
          <attributeEditorField index="1" name="removal_reason" showLabel="1"/>
        </attributeEditorContainer>
      </attributeEditorForm>
    </maplayer>
  </projectlayers>
</qgis>
