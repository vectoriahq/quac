        "https://vectoriahq.github.io/quac/v0.2.0/schema.json"
      ],
      "quac:light_style": "Bright",
      "quac:dark_style": "Dark",
      "assets": {
        "Bright": {
          "href": "https://tiles.example.com/styles/bright",
