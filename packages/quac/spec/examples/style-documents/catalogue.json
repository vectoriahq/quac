              "layers": [
                {
                  "id": "ferry",
                  "layout": {
                    "visibility": "none"
                  }
                }
              ]
            }
          ]
        },
        "Dark": {
          "href": "https://tiles.example.com/styles/dark",
          "type": "application/vnd.mapbox.style+json",
          "title": "Dark",
          "roles": [
            "style"
          ]
        }
