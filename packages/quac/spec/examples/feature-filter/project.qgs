<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Feature filter" version="3.44.8-Solothurn">
  <title>Feature filter</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="layer_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>layer_1</id>
      <datasource>./trees.geojson|subset=&quot;status&quot; = 'approved'</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
    </maplayer>
  </projectlayers>
</qgis>
