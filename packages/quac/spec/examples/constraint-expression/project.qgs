<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Constraint expression" version="3.44.8-Solothurn">
  <title>Constraint expression</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="trees_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>trees_1</id>
      <datasource>./trees_1.geojson</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="height"/>
      </fieldConfiguration>
      <constraints>
        <constraint field="height" constraints="4" notnull_strength="0" unique_strength="0" exp_strength="2"/>
      </constraints>
      <constraintExpressions>
        <constraint field="height" exp="&quot;height&quot; &lt; 80 AND &quot;height&quot; &gt; 0" desc="Between 0 and 80 metres"/>
      </constraintExpressions>
    </maplayer>
  </projectlayers>
</qgis>
