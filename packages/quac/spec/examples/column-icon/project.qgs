<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Field icon" version="3.44.8-Solothurn">
  <title>Field icon</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="trees_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>trees_1</id>
      <datasource>./trees_1.geojson</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="species"/>
      </fieldConfiguration>
      <customproperties><Option type="Map"><Option name="variableNames" type="StringList"><Option type="QString" value="quac_icon_species"/></Option><Option name="variableValues" type="StringList"><Option type="QString" value="leaf"/></Option></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
