<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Preset filters" version="3.44.8-Solothurn">
  <title>Preset filters</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="trees_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <properties>
    <Mergin>
      <Filtering>
        <Enabled type="bool">true</Enabled>
        <Filters type="QString">[{&quot;filter_name&quot;: &quot;Species&quot;, &quot;layer_id&quot;: &quot;trees_1&quot;, &quot;field_name&quot;: &quot;species&quot;, &quot;filter_type&quot;: &quot;Single select&quot;, &quot;sql_expression&quot;: &quot;\&quot;species\&quot; IS @@value@@&quot;}]</Filters>
      </Filtering>
    </Mergin>
  </properties>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>trees_1</id>
      <datasource>./trees_1.geojson</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="species"/>
        <field configurationFlags="NoFlag" name="planted"/>
      </fieldConfiguration>
    </maplayer>
  </projectlayers>
</qgis>
