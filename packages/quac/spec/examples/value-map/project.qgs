<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Value map" version="3.44.8-Solothurn">
  <title>Value map</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="trees_1" name="Trees" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Point" wkbType="Point">
      <id>trees_1</id>
      <datasource>./trees_1.geojson</datasource>
      <layername>Trees</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="status">
          <editWidget type="ValueMap">
            <config>
              <Option type="Map">
                <Option type="List" name="map">
                  <Option type="Map">
                    <Option type="QString" name="Healthy" value="healthy"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" name="Stressed" value="stressed"/>
                  </Option>
                  <Option type="Map">
                    <Option type="QString" name="Not recorded" value="{2839923C-8B7D-419E-B84B-CA2FE9B80EC7}"/>
                  </Option>
                </Option>
              </Option>
            </config>
          </editWidget>
        </field>
      </fieldConfiguration>
    </maplayer>
  </projectlayers>
</qgis>
