{
  "name": "@vectoriahq/quac",
  "version": "0.2.0-next.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Writes and reads QUAC, which adds map layer settings to STAC catalogues.",
  "keywords": [
    "stac",
    "qgis",
    "gis",
    "geospatial",
    "catalog",
    "map"
  ],
  "homepage": "https://github.com/vectoriahq/quac#readme",
  "bugs": {
    "url": "https://github.com/vectoriahq/quac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectoriahq/quac.git",
    "directory": "packages/quac"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/schema/quac.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./src/schema/quac.schema.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@types/geojson": "7946.0.16",
    "fflate": "0.8.3",
    "geostyler-style": "13.1.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "jsdom": "30.1.3",
    "linkedom": "0.18.13",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
