              "href": "../catalog.json"
            },
            {
              "rel": "via",
              "href": "../surveys.qgs",
              "title": "QGIS project"
            }
          ],
          "quac:display_field": "code",
          "quac:visibility_checked": true,
          "quac:editable": true,
          "quac:identifiable": true,
          "quac:opacity": 1,
          "quac:form_order": [
            "code",
            "surveyor",
            "visits",
            "surveyed_on",
            "kind",
            "healthy",
            "condition",
            "notes",
            "remarks",
            "photo",
            "sketch",
            "height",
            "closed"
          ],
          "quac:measurement": {
            "area_unit": "ha",
            "distance_unit": "km"
          },
          "stac_extensions": [
            "https://stac-extensions.github.io/table/v1.3.0/schema.json",
            "https://stac-extensions.github.io/vector/v0.1.0/schema.json",
            "https://stac-extensions.github.io/projection/v2.0.0/schema.json",
            "https://vectoriahq.github.io/quac/v0.3.0/schema.json"
          ],
          "vector:geometry_types": [
            "Point"
          ],
          "quac:qgis_server_wms_name": "Survey sites",
          "table:columns": [
            {
              "name": "site_id",
              "quac:editable": false,
              "quac:default": {
                "kind": "uuid",
                "format": "with_braces",
                "on_update": false
              },
              "quac:duplicate_policy": "unset",
              "quac:in_form": false
            },
            {
              "name": "code",
              "title": "Site code",
              "quac:default": {
                "kind": "uuid",
                "format": "without_braces",
                "on_update": false
              },
              "quac:constraints": {
                "unique": "warn"
              },
              "quac:duplicate_policy": "default"
            },
            {
              "name": "ref128",
              "quac:default": {
                "kind": "uuid",
                "format": "id128",
                "on_update": true
              },
              "quac:in_form": false
            },
            {
              "name": "surveyor",
              "title": "Surveyed by",
              "description": "The person who visited the site",
              "quac:default": {
                "kind": "fixed",
                "value": "Unknown surveyor",
                "on_update": false
              },
              "quac:reuse_last_value": true
            },
            {
              "name": "visits",
              "quac:default": {
                "kind": "fixed",
                "value": -1,
                "on_update": false
              },
              "quac:constraints": {
                "not_null": "enforced"
              },
              "quac:range": {
                "min": 0,
                "max": 10,
                "step": 1,
                "precision": 0,
                "suffix": " visits"
              }
            },
            {
              "name": "surveyed_on",
              "quac:constraints": {
                "not_null": "enforced"
              },
              "quac:date_format": "dd.MM.yyyy"
            },
            {
              "name": "logged_at",
              "quac:default": {
                "kind": "now",
                "on_update": true
              },
              "quac:in_form": false
            },
            {
              "name": "planted_on",
              "quac:default": {
                "kind": "now",
                "on_update": false
              },
              "quac:in_form": false
            },
            {
              "name": "healthy",
              "quac:default": {
                "kind": "fixed",
                "value": true,
                "on_update": false
              },
              "quac:checkbox": {
                "checked": "yes",
                "unchecked": "no",
                "show_stored": true,
                "allow_null": true
              },
              "quac:visible_when": [
                "\"visits\" > 0"
              ]
            },
            {
              "name": "kind",
              "description": "As on the site register",
              "quac:default": {
                "kind": "expression",
                "expression": "aggregate('Site kinds', 'max', \"code\", intersects($geometry, geometry(@parent)))",
                "on_update": false
              },
              "quac:reuse_last_value": true,
              "quac:control": "dropdown"
            },
            {
              "name": "notes",
              "quac:searchable": false,
              "quac:label_on_top": true,
              "quac:visible_when": [
                "\"visits\" > 0",
                "\"healthy\" = 'no'"
              ]
            },
            {
              "name": "photo",
              "quac:attachment": {
                "viewer": "image",
                "filter": "Images (*.jpg *.png)",
                "default_root": "/srv/survey/photos",
                "relative_storage": "default-root"
              },
              "quac:visible_when": [
                "aggregate('Site kinds', 'count', \"code\") > 0"
              ],
              "quac:editable_when": "aggregate('Site kinds', 'count', \"code\") = 0"
            },
            {
              "name": "sketch",
              "quac:attachment": {
                "default_root": "C:\\Survey\\sketches",
                "relative_storage": "absolute"
              },
              "quac:visible_when": [
                "aggregate('Site kinds', 'count', \"code\") > 0"
              ]
            },
            {
              "name": "field_notes",
              "quac:in_form": false
            },
            {
              "name": "height",
              "quac:default": {
                "kind": "expression",
                "expression": "\"visits\" * 2",
                "on_update": true
              },
              "quac:constraints": {
                "expression": {
                  "expression": "\"height\" >= 0",
                  "strength": "enforced"
                }
              }
            },
            {
              "name": "checked_by",
              "quac:editable": false,
              "quac:default": {
                "kind": "expression",
                "expression": "@user_account_name",
                "on_update": false
              },
              "quac:hidden": true,
              "quac:in_form": false
            },
            {
              "name": "condition",
              "quac:constraints": {
                "not_null": "enforced",
                "expression": {
                  "expression": "\"condition\" IN ('good', 'fair', 'poor')",
                  "description": "One of good, fair or poor",
                  "strength": "warn"
                }
              },
              "quac:label_on_top": true,
              "quac:visible_when": [
                "\"visits\" > 0",
                "\"healthy\" = 'no'"
              ],
              "quac:editable_when": "\"visits\" > 0"
            },
            {
              "name": "remarks",
              "quac:visible_when": [
                "aggregate('Site kinds', 'count', \"code\") > 0"
              ],
              "quac:editable_when": "\"healthy\""
            },
            {
              "name": "closed",
              "quac:editable": false,
              "quac:editable_when": "false"
            }
          ]
        }
