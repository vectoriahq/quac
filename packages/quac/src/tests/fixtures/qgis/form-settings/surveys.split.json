              "type": "application/geo+json",
              "title": "sites.geojson",
              "roles": [
                "data"
              ],
              "proj:code": "EPSG:4326"
            }
          },
          "links": [
            {
              "rel": "self",
              "href": "./sites_5c2e9a41_7d3b_4f60_a8e1_2b9c4d6f0a11.json"
            },
            {
              "rel": "parent",
              "href": "../catalog.json"
            },
