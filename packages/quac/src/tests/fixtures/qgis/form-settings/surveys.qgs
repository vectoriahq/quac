      </flags>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="code"/>
        <field configurationFlags="NoFlag" name="label"/>
      </fieldConfiguration>
      <aliases>
        <alias field="code" index="0" name=""/>
        <alias field="label" index="1" name="Kind"/>
      </aliases>
      <editorlayout>tablayout</editorlayout>
      <attributeEditorForm>
        <attributeEditorRelation name="kinds_sites" relation="" showLabel="1"/>
