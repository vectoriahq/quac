      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="bore_id"/>
        <field configurationFlags="NoFlag" name="depth"/>
        <field configurationFlags="NoFlag" name="owner"/>
      </fieldConfiguration>
      <aliases>
        <alias field="bore_id" index="0" name=""/>
        <alias field="depth" index="1" name=""/>
        <alias field="owner" index="2" name=""/>
      </aliases>
      <excludeAttributesWFS>
        <attribute>owner</attribute>
      </excludeAttributesWFS>
      <previewExpression>"bore_id"</previewExpression>
    </maplayer>
    <maplayer maxScale="0" minScale="100000000" hasScaleBasedVisibilityFlag="0" labelsEnabled="0" wkbType="Point" geometry="Point" type="vector" readOnly="0" styleCategories="AllStyleCategories">
