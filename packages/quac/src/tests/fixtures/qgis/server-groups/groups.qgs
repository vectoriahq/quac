      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="note_id"/>
        <field configurationFlags="NoFlag" name="author"/>
      </fieldConfiguration>
      <aliases>
        <alias field="note_id" index="0" name=""/>
        <alias field="author" index="1" name=""/>
      </aliases>
      <excludeAttributesWMS>
        <attribute>author</attribute>
      </excludeAttributesWMS>
      <previewExpression>"note_id"</previewExpression>
