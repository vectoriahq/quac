    <properties name="WFSLayers" type="QStringList"><value>water_bores_1a2b3c4d_5e6f_4a7b_8c9d_0e1f2a3b4c01</value><value>staff_notes_3c4d5e6f_7a8b_4c9d_0e1f_2a3b4c5d6e03</value></properties>
    <properties name="WFSTLayers">
