      <datasource>./sites.geojson</datasource>
      <shortname>monitoring_sites</shortname>
      <layername>Sites</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="site_id"/>
        <field configurationFlags="HideFromWms|HideFromWfs" name="contact"/>
      </fieldConfiguration>
      <aliases>
        <alias field="site_id" index="0" name=""/>
        <alias field="contact" index="1" name=""/>
      </aliases>
      <previewExpression>"site_id"</previewExpression>
