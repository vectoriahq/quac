<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Server groups" version="4.2.0-Belém do Pará">
  <homePath path=""/>
  <title>Server groups</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:4326</authid>
      <description>WGS 84</description>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-group checked="Qt::Checked" expanded="1" name="Water">
      <layer-tree-layer checked="Qt::Checked" source="./bores.geojson" expanded="1" name="Water: bores" providerKey="ogr" id="water_bores_1a2b3c4d_5e6f_4a7b_8c9d_0e1f2a3b4c01"/>
      <layer-tree-group checked="Qt::Checked" expanded="1" name="Monitoring">
        <layer-tree-layer checked="Qt::Checked" source="./sites.geojson" expanded="1" name="Sites" providerKey="ogr" id="sites_2b3c4d5e_6f7a_4b8c_9d0e_1f2a3b4c5d02"/>
      </layer-tree-group>
    </layer-tree-group>
    <layer-tree-group checked="Qt::Checked" expanded="1" name="Internal">
      <layer-tree-layer checked="Qt::Checked" source="./staff-notes.geojson" expanded="1" name="Staff notes" providerKey="ogr" id="staff_notes_3c4d5e6f_7a8b_4c9d_0e1f_2a3b4c5d6e03"/>
    </layer-tree-group>
  </layer-tree-group>
  <projectlayers>
    <maplayer maxScale="0" minScale="100000000" hasScaleBasedVisibilityFlag="0" labelsEnabled="0" wkbType="Point" geometry="Point" type="vector" readOnly="0" styleCategories="AllStyleCategories">
      <id>water_bores_1a2b3c4d_5e6f_4a7b_8c9d_0e1f2a3b4c01</id>
      <datasource>./bores.geojson</datasource>
