{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "tsBuildInfoFile": null,
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["src/tests", "src/**/*.test.ts"]
}
