        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="inspected"><editWidget type="DateTime"><config><Option type="Map"><Option type="QString" value="yyyy-MM-dd" name="field_format"/><Option type="bool" value="false" name="field_iso_format"/><Option type="QString" value="d MMM yyyy" name="display_format"/><Option type="bool" value="false" name="allow_null"/></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="notes"/>
      </fieldConfiguration>
      <aliases>
        <alias field="inspection_id" index="0" name="Inspection ID"/>
        <alias field="tree_id" index="1" name="Tree ID"/>
        <alias field="inspected" index="2" name="Inspected"/>
        <alias field="notes" index="3" name="Notes"/>
      </aliases>
