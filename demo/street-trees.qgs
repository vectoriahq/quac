      <fieldConfiguration>
        <field configurationFlags="NoFlag" name="tree_id"/>
        <field configurationFlags="NoFlag" name="species"><editWidget type="ValueRelation"><config><Option type="Map"><Option type="QString" value="species" name="Layer"/><Option type="QString" value="Species" name="LayerName"/><Option type="QString" value="code" name="Key"/><Option type="QString" value="common_name" name="Value"/><Option type="bool" value="false" name="AllowNull"/><Option type="bool" value="false" name="AllowMulti"/><Option type="bool" value="true" name="OrderByValue"/><Option type="QString" value="" name="FilterExpression"/></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="height"><editWidget type="Range"><config><Option type="Map"><Option type="int" value="0" name="Min"/><Option type="int" value="40" name="Max"/><Option type="double" value="0.5" name="Step"/><Option type="int" value="1" name="Precision"/><Option type="QString" value=" m" name="Suffix"/><Option type="bool" value="true" name="AllowNull"/></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="condition"><editWidget type="ValueMap"><config><Option type="Map"><Option type="List" name="map"><Option type="Map"><Option type="QString" name="Good" value="G"/></Option><Option type="Map"><Option type="QString" name="Fair" value="F"/></Option><Option type="Map"><Option type="QString" name="Poor" value="P"/></Option><Option type="Map"><Option type="QString" name="Dead" value="D"/></Option></Option></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="heritage"><editWidget type="CheckBox"><config><Option type="Map"><Option type="QString" value="Y" name="CheckedState"/><Option type="QString" value="N" name="UncheckedState"/><Option type="int" value="0" name="TextDisplayMethod"/><Option type="bool" value="false" name="AllowNullState"/></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="planted"><editWidget type="DateTime"><config><Option type="Map"><Option type="QString" value="yyyy-MM-dd" name="field_format"/><Option type="bool" value="false" name="field_iso_format"/><Option type="QString" value="d MMM yyyy" name="display_format"/><Option type="bool" value="true" name="allow_null"/></Option></config></editWidget></field>
        <field configurationFlags="NoFlag" name="removal_reason"/>
      </fieldConfiguration>
      <aliases>
        <alias field="tree_id" index="0" name="Tree ID"/>
        <alias field="species" index="1" name="Species"/>
        <alias field="height" index="2" name="Height"/>
        <alias field="condition" index="3" name="Condition"/>
        <alias field="heritage" index="4" name="Heritage listed"/>
        <alias field="planted" index="5" name="Planted"/>
        <alias field="removal_reason" index="6" name="Reason for removal"/>
      </aliases>
      <customComments>
        <customComment field="height" value="Measured from the ground to the top of the crown."/>
      </customComments>
      <labelOnTop>
        <field labelOnTop="1" name="removal_reason"/>
      </labelOnTop>
      <defaults>
        <default field="planted" expression="now()" applyOnUpdate="0"/>
      </defaults>
      <constraints>
        <constraint field="tree_id" constraints="3" notnull_strength="1" unique_strength="1" exp_strength="0"/>
        <constraint field="species" constraints="1" notnull_strength="1" unique_strength="0" exp_strength="0"/>
        <constraint field="height" constraints="4" notnull_strength="0" unique_strength="0" exp_strength="2"/>
      </constraints>
      <constraintExpressions>
        <constraint field="height" exp="&quot;height&quot; &lt; 40" desc="Taller than any tree on this street"/>
      </constraintExpressions>
      <editorlayout>tablayout</editorlayout>
      <attributeEditorForm>
        <attributeEditorField index="0" name="tree_id" showLabel="1"/>
        <attributeEditorField index="1" name="species" showLabel="1"/>
        <attributeEditorField index="2" name="height" showLabel="1"/>
        <attributeEditorField index="3" name="condition" showLabel="1"/>
        <attributeEditorField index="4" name="heritage" showLabel="1"/>
        <attributeEditorField index="5" name="planted" showLabel="1"/>
        <attributeEditorContainer name="Removal" showLabel="1" groupBox="1" type="GroupBox" columnCount="1" visibilityExpression="&quot;condition&quot; = 'D'" visibilityExpressionEnabled="1">
          <attributeEditorField index="6" name="removal_reason" showLabel="1"/>
        </attributeEditorContainer>
      </attributeEditorForm>
      <previewExpression>"tree_id"</previewExpression>
